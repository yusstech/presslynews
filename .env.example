# ─── Pressly environment (copy to .env and fill in) ───────────────────────────
#
# One Next.js app. There is no separate API, worker, Redis or search service, so
# there is nothing here to configure for them.

NODE_ENV=development

# Public origin. Used for canonical URLs, the RSS feed and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the newsroom session cookie. Must be at least 16 characters; the app
# refuses to start a session with a shorter one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-in-production


# ─── Postgres ─────────────────────────────────────────────────────────────────
# Local docker-compose default. In production DATABASE_URL is the pooled Neon
# connection and DIRECT_DATABASE_URL the direct one — migrations cannot run
# through a pooler, and serverless-style connection counts need the pooler.
DATABASE_URL=postgresql://pressly:pressly@localhost:5435/pressly?schema=public
DIRECT_DATABASE_URL=postgresql://pressly:pressly@localhost:5435/pressly?schema=public


# ─── Cloudinary (media) ───────────────────────────────────────────────────────
# Single-variable form, copied from the Cloudinary dashboard:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Leave it unset locally and uploads are written to apps/web/public/media
# instead — the original only, no resized variants, which is fine for
# development. NEVER leave it unset in production: a Render filesystem is wiped
# on every deploy, so every image would vanish.
# CLOUDINARY_URL=

# Or the three-variable form, if you prefer them separate.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Where the local fallback writes. Defaults to the web app's public/ directory;
# only set this if you need it somewhere else.
# MEDIA_LOCAL_DIR=/absolute/path/to/Pressly/apps/web/public


# ─── Scheduled publishing ─────────────────────────────────────────────────────
# Authorises GET /api/cron/publish-due, which releases stories whose publish
# date has arrived. The route returns 503 when this is unset — it fails closed
# rather than leaving a publishing endpoint open.
CRON_SECRET=

# Lets `pnpm db:publish` drop the Reader's cache after writing from outside the
# app. Optional: without it a new story is live on its own URL and reaches the
# listings within five minutes.
REVALIDATE_SECRET=
