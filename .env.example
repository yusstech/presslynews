# ─── Pressly environment (copy to .env and fill in) ───────────────────────────

NODE_ENV=development

# API
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the worker uses to invalidate Reader caches on publish.
REVALIDATE_SECRET=change-me-in-production

# Postgres (local docker-compose default)
DATABASE_URL=postgresql://pressly:pressly@localhost:5435/pressly?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6381

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=masterKey-change-me

# Cloudflare R2 (S3-compatible media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pressly-media
R2_PUBLIC_URL=https://media.pressly.example
# Where the local-disk media fallback lives when R2 is unset. The API serves
# this directory at /uploads and the worker writes derived variants into it, so
# both processes must resolve to the same absolute path.
# MEDIA_LOCAL_DIR=/absolute/path/to/Pressly/apps/api/uploads

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=no-reply@pressly.example

# ─── Deployment ───────────────────────────────────────────────────────────────
# Browser origins allowed to call the API (comma-separated). In production set
# this to the web app's public URL; locally NEXT_PUBLIC_SITE_URL is used.
# CORS_ORIGINS=https://pressly.vercel.app,https://www.pressly.example
# Optional: also allow any HTTPS host with this suffix, for Vercel previews.
# CORS_PREVIEW_SUFFIX=.vercel.app

# Unpooled connection, used only for migrations. Locally identical to
# DATABASE_URL; on Neon set this to the direct (non-pooler) host.
DIRECT_DATABASE_URL=postgresql://pressly:pressly@localhost:5435/pressly?schema=public
