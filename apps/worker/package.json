    "@pressly/search": "workspace:*",
    "@pressly/storage": "workspace:*",
    "@pressly/types": "workspace:*",
    "bullmq": "^5.21.2",
    "dotenv": "^16.4.5",
    "resend": "^4.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
